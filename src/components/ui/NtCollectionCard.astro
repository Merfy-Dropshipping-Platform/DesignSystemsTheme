---
interface Props {
  name: string;
  image: string;
  imageAlt?: string;
  eager?: boolean;
}

const { name, image, imageAlt, eager = false } = Astro.props;
const alt = imageAlt ?? `Изображение коллекции ${name}`;
---

<article
  class="group cursor-pointer"
  role="listitem"
  aria-label={`Коллекция ${name}`}
  data-nt="collection-card"
>
  <div
    class="relative mb-6 md:mb-8 aspect-[430/500] w-full overflow-hidden rounded-2xl bg-[#F5F5F5] shadow-sm transition-shadow duration-300 hover:shadow-lg"
  >
    <img
      src={image}
      alt={alt}
      width="430"
      height="500"
      loading={eager ? "eager" : "lazy"}
      decoding="async"
      class="h-full w-full object-cover transition-transform duration-500 ease-out group-hover:scale-110"
    />
    <div class="absolute inset-0 bg-[#000000]/0 transition-colors duration-300 group-hover:bg-[#000000]/5" />
  </div>
  <div class="px-1 md:px-2">
    <h3
      class="font-manrope text-lg md:text-[24px] font-normal text-[#000000] transition-colors duration-200 group-hover:text-[#424242]"
    >
      {name}
    </h3>
  </div>
</article>
